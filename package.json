{
  "name": "gladys-eufy-clean",
  "version": "0.1.0",
  "private": true,
  "description": "Gladys Assistant external integration for eufy robot vacuums (RoboVac, eufy Clean), through the eufy cloud. Unofficial, not affiliated with Anker or eufy.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=24.5"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0",
    "@mega-yfue/eufy-sdk": "0.5.0-beta.54"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
